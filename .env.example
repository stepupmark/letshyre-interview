VITE_API_BASE_URL=https://letshyre.com

VITE_AI_DETECTION_URL=https://ai.letshyre.com

VITE_MAIN_WEBSITE_URL=https://letshyre.com

VITE_AI_MAX_VIOLATIONS_ALLOWED=3

# Face mismatches with no match between them before auto-submit. Only a match
# resets the run; no-face frames, errors and pauses don't.
VITE_AI_FACE_MISMATCH_LIMIT=2

# Face mismatches across the whole interview before auto-submit.
VITE_AI_FACE_MISMATCH_TOTAL_LIMIT=3

# Seconds without a clear face before a hint, and before it counts as a mismatch.
VITE_AI_FACE_UNCLEAR_HINT_SECONDS=30
VITE_AI_FACE_UNCLEAR_LIMIT_SECONDS=60

# A mismatch only counts below this similarity. The candidate's own face dips to
# about 0.5 on a bad frame; someone else scores near 0. In between is treated as
# an unclear face.
VITE_AI_FACE_MISMATCH_BELOW=0.4

# Similarity below this on a clear frame ends the interview on the first
# mismatch. Honest mismatches in real logs scored 0.32 or more. Unset turns it off.
VITE_AI_FACE_STRONG_MISMATCH_BELOW=0.05

VITE_AI_INTERVIEW_DURATION_MINUTES=15

VITE_AI_MAX_INTERNET_DISCONNECTS=3
# Oldest desktop app allowed to start an interview; leave empty until that build is released.
VITE_MIN_DESKTOP_VERSION=

# How long the termination notice stays on screen before submission continues.
VITE_AI_TERMINATION_NOTICE_SECONDS=12

# Seconds a prohibited object or a switched-off camera can stay before it costs
# one more strike.
VITE_AI_HELD_RESTRIKE_SECONDS=30

# Set to "false" to stop flagging laptops as prohibited objects.
VITE_AI_PROHIBIT_LAPTOP=true

# Labels detected and logged but never shown to the candidate. Use this to
# measure a new rule against real interviews before it starts ending them.
# tv ships muted: it is the highest false-positive label in the set.
# laptop is ignored here while VITE_AI_PROHIBIT_LAPTOP is true.
VITE_AI_SHADOW_LABELS=tv

# Counts faces on the device between server checks, so a face leaving or a
# second person arriving is checked straight away. "false" turns it off.
VITE_AI_LOCAL_FACE_WATCH=true

# Looks for a phone on the device once a second, so one coming into view is
# checked straight away. "false" turns it off.
VITE_AI_LOCAL_OBJECT_WATCH=true

# Behaviour rules logged but never shown or counted; "none" enforces all.
# "gaze" = long look-away. "verify_faces" = no face or several people seen only by
# face verification (e.g. small faces in the background that detection ignores).
VITE_AI_SHADOW_RULES=gaze

# Confidence an object detection must carry before it can raise a violation.
# Lower it to catch more, raise it if cluttered rooms produce false warnings.
VITE_AI_OBJECT_CONFIDENCE_FLOOR=0.35

# Set to "true" to enable verbose console logs in a production build (default: disabled).
VITE_DEBUG_LOGS=false

# Note: Don't add / at the end of endpoint(url).

